#uses stack and dictionary
#is stack checks if stack is empty, return not stack gives true if empty and false if not 

class Solution:
    def isValid(self, s: str) -> bool:
        stack=[]
        pairs={")":"(","}":"{","]":"["}
        for ch in s:
            if ch in "[{(":
                stack.append(ch)
            else:
                if stack and stack[-1]==pairs[ch]:
                    stack.pop()
                else:
                    return False
        return not stack          
