#difference=dictionary used=1,time and space complexity remains same

class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        if len(s) != len(t):
            return False

        freq = {}

        for char in s:
            if char in freq:
                freq[char] += 1
            else:
                freq[char] = 1

        for char in t:
            if char in freq:
                freq[char] -= 1
            else:
                freq[char] = -1

        return all(values == 0 for values in freq.values())
